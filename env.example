# SAM3 Detector Filter Configuration
# Copy this file to .env and adjust values as needed

# Required: Input video path (used by scripts)
VIDEO_PATH=

# OpenFilter standard variables (automatically handled by Filter.normalize_config)
# FILTER_SOURCES: Input source - can override in filter config
# FILTER_OUTPUTS: Output destination - can override in filter config

# Required: Choose one detection method
# Text prompt for object detection (e.g., "person", "car", "dog")
FILTER_TEXT_PROMPT=

# OR: Path to directory with exemplar images (alternative to text prompt)
# Each image should show one instance of what you want to detect
FILTER_EXEMPLARS_PATH=

# Reference boxes on the original image (SAM3-style): JSON array of [x, y, w, h] in pixels per box
# Optional; use with or without FILTER_TEXT_PROMPT. Detections similar to positive boxes are encouraged, negative suppressed.
# When FILTER_POSITIVE_BOXES or FILTER_NEGATIVE_BOXES are set, reference images (REF_IMGS) are NOT used — boxes take priority.
# FILTER_POSITIVE_BOXES='[[480,290,110,360],[370,280,115,375]]'
# FILTER_NEGATIVE_BOXES='[[100,100,50,200]]'

# Reference images (REF_IMGS): pasted on composite (frame + refs). Only used when NO ref boxes are set.
# Comma-separated paths; directories are expanded to image files. Requires FILTER_TEXT_PROMPT.
# FILTER_REF_IMAGES=/path/to/pos1.jpg,/path/to/pos_dir
# FILTER_REF_IMAGES_NEGATIVE=/path/to/neg1.jpg
# When set (e.g. composite), the filter publishes the composite image on this topic for inspection (e.g. Webvis /composite).
# FILTER_COMPOSITE_TOPIC=composite
# Ref layout: overlay = refs on frame (inside); side_strips = refs in lateral strips (outside). Positive=left, negative=right.
# FILTER_REF_IMAGES_LAYOUT=overlay
# FILTER_REF_STRIP_WIDTH=120
# FILTER_REF_MAX_HEIGHT=80  # Max height (px) of each ref when pasted; clamped 1–4000, runtime cap = frame height

# Model configuration
FILTER_MODEL_ID=facebook/sam3
FILTER_DEVICE=cuda

# Detection parameters
FILTER_CONFIDENCE_THRESHOLD=0.5
FILTER_MASK_THRESHOLD=0.5
FILTER_MAX_DETECTIONS=100

# NMS (Non-Maximum Suppression) - reduces overlapping detections
FILTER_NMS_ENABLED=true
FILTER_NMS_THRESHOLD=0.5  # IoU threshold: lower = more aggressive (0.3-0.7 typical range)

# Output configuration
FILTER_OUTPUT_MASKS=false  # Set to true to save mask data (can be large)
FILTER_OUTPUT_BOXES=true
FILTER_OUTPUT_SCORES=true
FILTER_OUTPUT_LABEL=sam3_detections

# Visualization and debugging
FILTER_VISUALIZE=false
# When set (e.g. viz), main topic gets original frame + meta; this topic gets frame with bboxes + same meta. Leave unset for legacy behavior.
# FILTER_VIZ_TOPIC=viz
FILTER_SAVE_ANNOTATED_FRAMES=false  # Enable saving annotated frames (default: false, saves to frames_annotated when true)

# Output configuration
FILTER_OUTPUT_DIR=./output
FILTER_OUTPUT_PATH=./output/detections.jsonl  # Path to save JSONL annotations (optional)
FILTER_FRAMES_OUTPUT_DIR=./output/frames  # Directory to save original frames (default: always saved if configured)
FILTER_ANNOTATED_FRAMES_OUTPUT_DIR=./output/frames_annotated  # Directory to save annotated frames (optional, default: {FILTER_FRAMES_OUTPUT_DIR}/frames_annotated)
FILTER_RESIZE=

# Video loop (scripts only): set to true so video keeps sending frames while SAM3 loads (~14s). Use for short videos.
# FILTER_VIDEO_LOOP=false

