# SAM3 Detector Filter Configuration
# Copy this file to .env and adjust values as needed

# Required: Input video path (used by scripts)
VIDEO_PATH=

# OpenFilter standard variables (automatically handled by Filter.normalize_config)
# FILTER_SOURCES: Input source - can override in filter config
# FILTER_OUTPUTS: Output destination - can override in filter config

# Required: Choose one detection method
# Text prompt for object detection (e.g., "person", "car", "dog")
FILTER_TEXT_PROMPT=

# OR: Path to directory with exemplar images (alternative to text prompt)
# Each image should show one instance of what you want to detect
FILTER_EXEMPLARS_PATH=

# Model configuration
FILTER_MODEL_ID=facebook/sam2-hiera-large
FILTER_DEVICE=cuda

# Detection parameters
FILTER_CONFIDENCE_THRESHOLD=0.5
FILTER_MASK_THRESHOLD=0.5
FILTER_MAX_DETECTIONS=100

# Output configuration
FILTER_OUTPUT_MASKS=false  # Set to true to save mask data (can be large)
FILTER_OUTPUT_BOXES=true
FILTER_OUTPUT_SCORES=true
FILTER_OUTPUT_LABEL=sam3_detections

# Visualization and debugging
FILTER_VISUALIZE=false
FILTER_SAVE_ANNOTATED_FRAMES=false  # Enable saving annotated frames (default: false, saves to frames_annotated when true)

# Output configuration
FILTER_OUTPUT_DIR=./output
FILTER_OUTPUT_PATH=./output/detections.jsonl  # Path to save JSONL annotations (optional)
FILTER_FRAMES_OUTPUT_DIR=./output/frames  # Directory to save original frames (default: always saved if configured)
FILTER_ANNOTATED_FRAMES_OUTPUT_DIR=./output/frames_annotated  # Directory to save annotated frames (optional, default: {FILTER_FRAMES_OUTPUT_DIR}/frames_annotated)
FILTER_RESIZE=

