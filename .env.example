# Compose template for filter-sam3-detector
# Usage:
#   cp .env.example .env
#   docker compose -f docker-compose.yaml up -d

# Shared settings
VIDEO_PATH=./data/car.mp4
FILTER_DEVICE=cuda
FILTER_CONFIDENCE_THRESHOLD=0.5

# Output paths (container paths used by compose)
FILTER_OUTPUT_DIR=./results
FILTER_OUTPUT_PATH=/output/detections.jsonl
FILTER_COCO_OUTPUT_PATH=/output/labels_coco.json
FILTER_FRAMES_OUTPUT_DIR=/output/frames
FILTER_SAVE_ANNOTATED_FRAMES=true
FILTER_ANNOTATED_FRAMES_OUTPUT_DIR=/output/annotated_frames
FILTER_AUTO_EXPORT_COCO=true
FILTER_VISUALIZE=true

# ---------------------------------------------------------------------------
# Choose ONE prompt mode per run (leave others empty)
# 1) Single text prompt
# Matches the bundled ./data/car.mp4 used by compose by default.
FILTER_TEXT_PROMPT=car

# 2) Multi prompt
# FILTER_TEXT_PROMPTS=car,truck

# 3) Positive box prompt
# FILTER_POSITIVE_BOXES=[[247, 59, 14, 169]]

# 4) Reference image prompt (requires compose volume ./data:/data)
# FILTER_REF_IMAGES=/data/electrical_post.png

# Optional prompt inputs
FILTER_TEXT_PROMPTS=
FILTER_POSITIVE_BOXES=
FILTER_NEGATIVE_BOXES=
FILTER_REF_IMAGES=
FILTER_REF_IMAGES_NEGATIVE=
